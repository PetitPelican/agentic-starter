{
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Bash(*)",
      "Write(*)",
      "Read(*)",
      "Bash(npm *)",
      "Bash(npx *)"
    ],
    "deny": [
      "Bash(git commit*)",
      "Bash(git push*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/memory-guard.py",
            "if": "Bash(git push*)",
            "timeout": 20,
            "statusMessage": "Garde-fou mémoire (git push)"
          }
        ]
      }
    ]
  }
}
